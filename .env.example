# Database — local SQLite file by default. Production/Preview: a Turso URL (libsql://…) + token; apply the schema
# with `npm run db:migrate` (db:push / db:reset refuse non-file databases).
DATABASE_URL=file:./data/accphe.db
DATABASE_AUTH_TOKEN=

# 32+ random characters (openssl rand -base64 48). Signs sessions and hashes one-time tokens.
AUTH_SECRET=change-me-to-a-long-random-string

# Public base URL, no trailing slash. Used for canonical URLs, sitemap, structured data and email links.
APP_URL=http://localhost:3000

# Email (Resend). Without RESEND_API_KEY emails are only recorded in the outbox (development: /portal/dev-mail).
RESEND_API_KEY=
EMAIL_FROM="ACCPHE Secretariat <no-reply@accphe.example>"
# Address that receives new-inquiry and new-message alerts in addition to staff who opted in.
SECRETARIAT_EMAIL=
# EMAIL_DELIVERY=off lets production start without Resend (emails are only recorded).
EMAIL_DELIVERY=

# File storage: "local" (./storage, development only) or "vercel-blob" (a *private* Blob store; required in production).
STORAGE_DRIVER=local
BLOB_READ_WRITE_TOKEN=

# Protects /api/cron/digest (weekly Monday summary). Vercel Cron sends it automatically.
CRON_SECRET=

# Commission: number of non-recused votes at which staff are prompted to record the decision.
COMMISSION_QUORUM=3

# Require two-step verification for every staff, reviewer and Commission account (recommended in production).
REQUIRE_STAFF_MFA=

# DEMO_MODE=1 shows "Reset demonstration data" to administrators (development and previews only; refused in production).
DEMO_MODE=

# Search engines. Indexing is allowed only when APP_URL is https and this is a production deployment.
# Force with SITE_INDEXABLE=true|false.
SITE_INDEXABLE=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Official profiles, comma-separated, added to the Organization structured data.
ORG_SAME_AS=
