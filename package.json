{
  "name": "accphe",
  "version": "1.0.0",
  "private": true,
  "description": "ACCPHE public website and Staff & Institution Portal",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "node --env-file-if-exists=.env.local scripts/guard-local-db.mjs && drizzle-kit push --force",
    "db:seed": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/seed.ts",
    "db:reset": "node --env-file-if-exists=.env.local scripts/guard-local-db.mjs && rm -rf data storage && mkdir -p data && npm run db:push && npm run db:seed",
    "admin:create": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/create-admin.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@vercel/blob": "^2.8.2",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.0",
    "otplib": "^13.5.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/public-sans": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
